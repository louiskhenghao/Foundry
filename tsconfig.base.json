{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["@types/bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": {
      "@ai-engine/core": ["./packages/core/src/index.ts"],
      "@ai-engine/core/*": ["./packages/core/src/*"],
      "@ai-engine/runner": ["./packages/runner/src/index.ts"],
      "@ai-engine/engine": ["./packages/engine/src/index.ts"],
      "@ai-engine/engine/skills-types": ["./packages/engine/src/skills/types.ts"],
      "@ai-engine/engine/usage-types": ["./packages/engine/src/usage/types.ts"],
      "@ai-engine/server": ["./packages/server/src/index.ts"]
    }
  }
}
